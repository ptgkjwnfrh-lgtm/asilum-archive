# ASILUM environment — copy to .env.local and fill in. Never commit real keys.
# Local development can run without these (in-memory store, demo catalog).
# Production requires the identity and database values described below.

# ---- Supabase (preferred backend: auth + Postgres + storage) ----
# Client-safe (exposed to the browser by Next.js — anon key only, never service role):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Storage administration/signing key for private wardrobe photos.
# Never prefix this with NEXT_PUBLIC and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Local/staging load-test fixtures only. Production builds always suppress them.
NEXT_PUBLIC_ENABLE_DEMO_SOCIAL=0
# Runtime Postgres connection string. Production requires the least-privilege
# asilum_app role created by schema v11; use its transaction-pooler URL here.
DATABASE_URL=
DATABASE_EXPECTED_ROLE=asilum_app
# Serverless deployments should use Supabase's transaction pooler URL. Keep the
# application-side pool small because each warm instance creates its own pool.
DATABASE_POOL_MAX=5
# One-time local role setup only. Never deploy or commit these values; remove
# them from .env.local after `npm run db:configure-role` succeeds.
DATABASE_ADMIN_URL=
DATABASE_APP_PASSWORD=
# Local Postgres integration tests only; production rejects "disable".
DATABASE_SSL_MODE=verify-full
# TLS trust anchor for DATABASE_URL — inline PEM or a path. Supabase chains to
# its own root CA (not in node's trust store): use the checked-in copy below.
# Verify its SHA256 fingerprint against the dashboard's SSL cert download:
# 80:70:25:AD:50:D4:ED:21:9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA
DATABASE_SSL_CA=supabase/prod-ca-2021.crt

# ---- eBay Browse API (the one LIVE source adapter — lib/ingest/adapters/ebayAdapter.js) ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_PARTNERSHIP_APPROVED=0
# Separate owner attestation: eBay has granted bulk Feed Beta entitlement.
# Does not grant AI processing permission. Never enable merely to pass a check.
EBAY_FEED_APPROVED=0
# EBAY_ENV=PRODUCTION for live listings (defaults to SANDBOX)
EBAY_ENV=
# Marketplace account deletion/closure notifications — required by eBay before
# a PRODUCTION keyset works (app/api/ebay/account-deletion/route.js). The token
# is 32–80 chars of [A-Za-z0-9_-]; the SAME value goes into the developer
# portal. The endpoint hashed must equal the URL typed there — default is
# SITE_ORIGIN + /api/ebay/account-deletion; override only if the portal holds
# a different spelling.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
# Paid-adapter hard ceilings. Each request needs a signed device cookie and
# consumes both budgets; the global ceiling protects upstream API spend.
EBAY_USER_MINUTE_LIMIT=30
EBAY_GLOBAL_MINUTE_LIMIT=300

# ---- Admin/moderation API (/api/admin — disabled until set, 16+ chars) ----
ADMIN_TOKEN=
# Server-controlled name recorded in moderation and audit ledgers.
ADMIN_ACTOR=admin

# ---- AI search seam (lib/ai/search-adapter.js) — local rule/tag logic when
#      false/unset; flipping true without a wired provider reports honestly ----
AI_SEARCH_ENABLED=

# ---- Passport influenced-assumption clause (r10) — broad cultural queries
#      narrow to the user's taste-favored reading; 0 kills it without a deploy ----
SEARCH_PASSPORT_ASSUMPTION=

# ---- Bounded bridge self-tuning (r16) — attributed history drifts the core
#      blend inside declared floors/caps; 0 kills it without a deploy ----
BRAIN_BRIDGE_TUNING=

# ---- Gamma corroboration (v22) — the item-item co-engagement bridge scores on
#      DISTINCT contributor count rather than summed weight, so one identity
#      engaging repeatedly cannot manufacture consensus.
#      LEAVE THIS BLANK (enabled). It is a SECURITY CONTROL, not a tuning knob:
#      scripts/measure-graph-corroboration.mjs measured a forged item at rank 37
#      of a victim's 60-slot page under the legacy rule, and absent under this
#      one. Setting 0 restores the legacy summed-weight rule and reopens that.
#      Known consequence (audit 2026-08-15): every production edge sits at
#      contributors=0, so gamma is currently inert — /stats now reports
#      "gamma usable" so this is visible instead of hiding behind an edge count.
#      The fix is to rebuild contributors from the real per-identity event
#      ledger, NOT to disable the control.
BRAIN_EDGE_CORROBORATION=

# ---- Search→brain loop (r17) — an APPLIED cultural reading trains the
#      profile at bounded save weight; 0 kills it without a deploy ----
SEARCH_BRAIN_LOOP=

# ---- Pinterest OAuth (future: moodboard inspiration import, real OAuth only) ----
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---- Shopify Storefront API (future: independent designer stores) ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Merchant-owned WooCommerce Store API. Never set approval without permission.
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_STORE_APPROVED=0

# Global cost circuit breakers (anonymous-abuse boundary, THREAT-MODEL.md §6).
# Per-minute budgets each expensive surface shares across ALL callers; 0
# disables a breaker. Defaults live in lib/security/rateLimit.js.
#GLOBAL_BUDGET_SEARCH=3000
#GLOBAL_BUDGET_INTERPRET=1800
#GLOBAL_BUDGET_DISCOVER=4000
#GLOBAL_BUDGET_FEED=4000
#GLOBAL_BUDGET_IDENTITY_ISSUE=300
# (audit #20) WRITE surfaces now have breakers too — reads failed closed
# while writes (profile/edge/popularity mutations) had no aggregate ceiling.
# INTERACTION charges per event in a batch (up to 20/request).
#GLOBAL_BUDGET_INTERACTION=4000
#GLOBAL_BUDGET_BOARDS=2000
#GLOBAL_BUDGET_INTERPRET_FEEDBACK=1800

# Exact comma-separated HTTPS hostnames the ingestion route may contact.
INGEST_ALLOWED_HOSTS=merchant.example,api.merchant.example
INGEST_TOKEN=
OFFICIAL_API_KEY=

# ---- Alpha Learning Brain providers (future; see lib/ALPHA-BRAIN.md) ----
# Embeddings (lib/embeddings v1 — text/visual vectors):
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
# optional: override model / point at a self-hosted OpenAI-shape endpoint
EMBEDDINGS_MODEL=
EMBEDDINGS_URL=
# Vision (lib/vision — moodboard image analysis + fit-pic analyzer):
VISION_PROVIDER=
VISION_API_KEY=

# Random secret (32+ characters) used to sign HttpOnly anonymous-device cookies.
DEVICE_COOKIE_SECRET=replace-with-at-least-32-random-characters

# ---- Asterisk AI adapter (lib/ai/adapter.js — Day 9 seam, Day 10 provider) ----
# ALL disabled by default; the app runs fully and honestly with none set.
# A feature calls a real model only when AI_FEATURES_ENABLED=true AND
# AI_PROVIDER is set AND AI_API_KEY exists AND the per-feature flag is true.
# The anthropic provider is IMPLEMENTED (Day 10). To enable:
#   AI_PROVIDER=anthropic
#   AI_MODEL_NAME=claude-haiku-4-5   (cheap/fast; claude-sonnet-4-6 or
#                                     claude-opus-4-8 for higher quality)
#   AI_API_KEY=<server-only Anthropic key — never NEXT_PUBLIC>
AI_FEATURES_ENABLED=false
AI_PROVIDER=none
AI_MODEL_NAME=
AI_API_KEY=
AI_MOOD_BOARD_ENABLED=false
AI_STYLIST_ENABLED=false
# Asterisk dual-tag audit (lib/asterisk/tagAudit.js). Off = honest local rules.
AI_TAG_AUDIT_ENABLED=false
# Model-assisted research drafting (lib/asterisk/research.js). Off = proposals
# are hand-submitted via admin asterisk.research.propose; nothing is faked.
AI_RESEARCH_ENABLED=false
# Unknown-query demand aggregation (lib/asterisk/unknownQueries.js). Off =
# unresolved queries are answered honestly but not recorded. Enable once the
# owner sets the retention period (docs/DATA-INVENTORY.md, DRAFT 180 days).
ASTERISK_UNKNOWN_QUERIES_ENABLED=false
# Hard ceilings for paid model calls (per feature). User-derived moodboard and
# stylist requests also require explicit aiConsent=true in the request.
AI_USER_HOURLY_LIMIT=12
AI_GLOBAL_HOURLY_LIMIT=200
# Comma-separated CDN hostnames whose product images may be downloaded for
# merchant-stated color verification (for example: cdn.partner.example).
INGEST_IMAGE_ALLOWED_HOSTS=

# Feature C Phase 3b — garment photo uploads (private Storage). Create the
# bucket first: node scripts/setup-wardrobe-storage.mjs — then enable.
# WARDROBE_UPLOADS_ENABLED=1

# Feature D — cultural Discover rails (registry + per-user collapse/hide).
# Default ON; 0 is the kill switch (rails API answers 503, Discover stays
# strip-only). Per-rail control lives in the discover_rails registry rows.
# DISCOVER_RAILS_ENABLED=1

# Feature E — profile rooms (signed-in accounts claim a handle, theme, and
# modules; statements pass a deterministic sanitize+screen pipeline).
# Default ON; 0 is the kill switch (rooms API answers 503, /profile keeps
# the default skin, published rooms 404).
# PROFILE_THEMES_ENABLED=1

# ---- Identity issuance (Aug 6) ----------------------------------------------
# NOTE: on Vercel an env change needs a REDEPLOY to reach running code. The
# Firewall rate-limit rule is the only true no-deploy lever.
#
# The trusted-IP mechanism is OFF unless a header is named here. Leave empty
# anywhere that is not behind an edge which overwrites the header — Next.js
# preserves a client-supplied x-forwarded-for, so an unguarded read trusts the
# attacker. Production Vercel: x-vercel-forwarded-for (verify empirically
# before enabling; see docs/THREAT-MODEL.md).
#TRUSTED_EDGE_IP_HEADER=x-vercel-forwarded-for
# Required whenever the header above is set (>=32 chars). Rotating it
# invalidates all prior rate-limit digests at zero cost.
#RATE_LIMIT_SUBJECT_SALT=
# Per trusted-caller issuance ceiling, NAT-safe by design (a carrier NAT fronts
# 10^4-10^5 subscribers). Isolation control, NOT a sybil price.
#IDENTITY_ISSUE_SUBJECT_LIMIT=2000
# Coarse ceiling for callers with no trusted subject — far above legitimate
# traffic so it can never be what locks out a first visitor.
#IDENTITY_ISSUE_PUBLIC_LIMIT=5000
# THE aggregate bound. consumeGlobalBudget only does 60-second windows, so
# before this existed the accidental 30/hour bucket was the only sustained
# ceiling. Lower it against measured new-visitor volume; never raise it
# against a guess. 0 disables.
#IDENTITY_ISSUE_GLOBAL_HOURLY=3000
# Issuance fails OPEN on limiter INFRASTRUCTURE failure (quota exhaustion
# still 429s). Issuance writes nothing and everything the identity can do is
# separately quota'd, so an over-issued identity costs ~0 while a denied one
# costs a real visitor the whole product. 0 restores fail-closed.
#IDENTITY_ISSUE_FAIL_OPEN=1

# --- search culture guidance (Aug 5) -----------------------------------------
# Cultural references (entities + era-qualified strings) in /api/suggest.
# 0 restores the pre-Aug-5 vocabulary (brands/aesthetics/mappings/garments).
#SEARCH_CULTURE_SUGGEST=1
# Era words in a query pick that interpretation ("kanye west polo era").
# Ordering only — readings are never erased. 0 disables.
#SEARCH_ERA_TARGETING=1
# Cultural-read racks order by the reading's own garment/material words
# matched whole-word in titles (the era's actual look first). Inclusion is
# untouched (r10 exact-slate-hit contract). 0 disables.
#SEARCH_ERA_ANCHORS=1

# --- Stripe checkout engine (Aug 18, risk campaign L2) -----------------------
# Hosted Checkout only: card data lives on stripe.com, never here. Unkeyed
# deploys answer 503 on /api/checkout and /api/stripe/webhook — honestly idle.
# sk_test_ builds and verifies the engine; the LIVE key is an owner step at
# launch, set in the deploy platform, never in code.
#STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Dashboard → Webhooks → the endpoint
# pointing at /api/stripe/webhook). Orders still settle without it via
# reconcile-on-read; the webhook makes settlement push instead of pull.
#STRIPE_WEBHOOK_SECRET=
# Existing TEST connected account used only by the isolated
# `npm run verify:stripe-connect` proof. Runtime seller account ids are private
# database records resolved by the server, never accepted from the browser.
#STRIPE_CONNECT_ACCOUNT_ID=
# Optional stable id for safely retrying the same isolated test proof.
#STRIPE_CONNECT_VERIFY_RUN_ID=

# --- Native Storefront rollout ---------------------------------------------
# Surface and draft/listing writes default ON; set either to 0 for a reversible
# rollback. Money is separate and defaults OFF.
#STOREFRONT_ENABLED=1
#NATIVE_LISTINGS_ENABLED=1
# New native attempts require =1, durable DATABASE_URL and a recognized Stripe
# key mode. This does not disable webhook/refund/reconciliation of old attempts.
NATIVE_CHECKOUT_ENABLED=0
# Separate opt-in. The $30 is never a buyer line; while off it simply remains
# outstanding. Requires the current validation artifact below.
STOREFRONT_FEE_COLLECTION_ENABLED=0
# Live connected-account money additionally requires both values and explicit
# owner authorization. Never copy a value here just to satisfy a test.
STRIPE_CONNECT_LIVE_ENABLED=0
# Set only to the exact version emitted by a successful isolated Stripe Connect
# TEST run; current code expects stripe-connect-direct-v1-2026-10-03.
STOREFRONT_PAYMENT_VALIDATION_VERSION=

# --- Order-paid operator notification (Aug 18, risk campaign F29/F74) --------
# Both required or the notifier is a silent no-op; the order LEDGER is the
# authority either way. Key is SendGrid, Mail Send scope ONLY (create a second
# restricted key — do not reuse the Supabase SMTP key).
#SENDGRID_API_KEY=
#ORDER_NOTIFY_EMAIL=

# Stripe publishable key (client-side, Payment Element in the checkout housing).
# pk_test_ in sandbox, pk_live_ at launch. Public by design — it ships in the bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Search-console ownership proofs (docs/seo-notes.md § getting indexed).
# Public tokens, not secrets; the meta tag renders only when set.
# Google Search Console → "HTML tag" verification method.
#GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (its index also serves Yahoo + DuckDuckGo) → meta tag.
#BING_SITE_VERIFICATION=
# Wire images (V.2 composer "Add media"): the public-read "wire" bucket, created by
# `npm run storage:wire`. Off until set to 1; the composer says so.
WIRE_UPLOADS_ENABLED=0
# Wire VIDEO (V.2 slice 9, MOTION): a signed direct upload to the same bucket and the
# media worker's probe (lib/media/index.js — no transcoder: H.264 MP4 / VP8-VP9 WebM
# only, admitted or refused by name). Needs WIRE_UPLOADS_ENABLED=1; re-run
# `npm run storage:wire` after flipping it so the bucket admits video/mp4 and video/webm.
WIRE_VIDEO_ENABLED=0

# ---- the music seams (V.2 chapter 4; CONSTITUTION A6 (3)) --------------------
# Spotify: the approved app's credentials from the Spotify for Developers
# dashboard (docs/v2/applications/spotify-developer-application.md — the owner
# submits). Unset = every Spotify capability answers REQUIRES APPROVAL.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
# Apple Music (MusicKit): the Apple Developer team, the MusicKit key id and the
# .p8 private key (docs/v2/applications/apple-music-developer-program.md).
# Unset = every Apple Music capability answers REQUIRES APPROVAL.
#APPLE_MUSIC_TEAM_ID=
#APPLE_MUSIC_KEY_ID=
#APPLE_MUSIC_PRIVATE_KEY=
