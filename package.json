{
  "name": "asilum-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ebay:feed": "node scripts/stage-ebay-feed.mjs",
    "ebay:publish": "node scripts/publish-ebay-feed.mjs",
    "ebay:worker": "node scripts/ebay-feed-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "db:configure-role": "node scripts/configure-database-role.mjs",
    "test": "node --test tests/*.test.js",
    "trends:check": "node scripts/check-trend-freshness.mjs",
    "research:compile": "node scripts/compile-culture-research.mjs",
    "start": "next start",
    "deploy:check": "node scripts/check-deploy-drift.mjs",
    "triggers:check": "node scripts/check-deferred-triggers.mjs",
    "floor:check": "node scripts/measure-match-floor.mjs",
    "steward": "node scripts/steward.mjs",
    "test:live-stripe": "STRIPE_TEST_REQUIRED=1 STRIPE_SECRET_KEY=$(grep '^STRIPE_SECRET_KEY=' .env.local | cut -d= -f2-) node --test tests/stripe-live.test.js",
    "verify:stripe-connect": "node scripts/verify-stripe-connect-storefront.mjs",
    "storefront:reconcile": "node scripts/reconcile-storefront-payments.mjs",
    "docs:codemap": "node scripts/generate-code-map.mjs",
    "storage:wire": "node scripts/setup-wire-storage.mjs",
    "storage:dm": "node scripts/setup-dm-storage.mjs",
    "dm:archive": "node scripts/dm-archive-sweep.mjs",
    "verify:listings": "node scripts/verify-listings.mjs",
    "release:checks": "node scripts/measure-release-checks.mjs",
    "likes:status": "node scripts/listing-status.mjs",
    "audit:nav": "node scripts/audit-navigability.mjs",
    "feed:rotation": "node scripts/measure-feed-rotation.mjs",
    "feed:chunks": "node scripts/measure-feed-chunks.mjs",
    "search:snapshot": "node scripts/search-identity-snapshot.mjs",
    "search:latency": "node scripts/measure-search-latency.mjs",
    "v2:gates": "node scripts/measure-v2-gates.mjs",
    "v2:check": "npm run -s v2:gates && npm run -s search:latency && npm run -s feed:chunks"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.5",
    "fastest-levenshtein": "^1.0.16",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.5",
    "stemmer": "^2.0.1"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
